# Copy to .env and fill in for a real deployment. The scaffold runs without any
# of these; unset RPC_URL_* just means no chain reads until they are set.

PORT=3000

# Postgres connection string. SET = production store (survives restarts).
# Unset = local JSON file store (data/db.json, dev/tests only).
DATABASE_URL=

# Robinhood Chain (chain id 4663) RPC providers, production only.
# Currently unused by any endpoint — the $10 holder check happens on-chain
# at mint time, by design. Kept for future use.
RPC_URL_1=
RPC_URL_2=

# Contracts (MDOG is locked; NFT address is set after deployment).
MDOG_CONTRACT=0x4CAF2e6eC0fCBef77314566A9884643512EF8bfC
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Holder threshold, advertised in /config. The API never checks balances —
# the multisig sets holderThresholdMDOG on-chain and the contract reverts
# HOLDER mints below it at mint time. There is no live price feed in the API.
THRESHOLD_USD=10

# Salt for the keyed identity/wallet hashes.
# The production value is PERMANENT — never rotate it: rotation orphans every
# registration and allowlist hash. Set once, then never touch it again.
HASH_SALT=change-me-once-then-never-again

# Public timeline placeholders.
CURRENT_PHASE=rules-locked
REGISTRATION_OPENS=TBD
REGISTRATION_CLOSES=TBD
SNAPSHOT_BLOCK=TBD
COMMUNITY_MINT_STARTS=TBD

# Test-only: TEST_MODE=1 stubs the musebook identity registry from
# MUSEBOOK_REGISTRY_STUB_FILE so smoke.js runs with no network.
# NEVER set TEST_MODE=1 in production.
TEST_MODE=
MUSEBOOK_REGISTRY_STUB_FILE=

# --- Community mint / claim relayer ---
# Chain the Muse Dogs NFT contract lives on (default 4663, Robinhood Chain).
# Set to 31337 for a local Anvil rehearsal.
NFT_CHAIN_ID=4663

# Block explorer used for transaction links in claim status responses.
EXPLORER_TX_URL=https://robinhoodchain.blockscout.com/tx/

# EIP-712 voucher signer key (0x-prefixed 32-byte hex). WITHOUT this the
# /community-voucher and /holder-voucher endpoints fail closed (503). This key
# only signs vouchers; it cannot move funds. Store in a KMS in production —
# never in git.
VOUCHER_SIGNER_KEY=

# Claim relayer: submits claim() for muses and pays the gas. The NFT always
# mints to the voucher's claimant, so the relayer cannot redirect or steal.
# Its key should hold gas money only.
RELAYER_ENABLED=0
RELAYER_RPC_URL=
RELAYER_PRIVATE_KEY=

# --- Holder rewards (weekly epochs) ---
# Address (multisig) that publishes the weekly rewards merkle root on-chain.
REWARDS_PUBLISHER=
# RewardsVault contract holders claim() from. Until deployed, /rewards/config
# reports "TBD" honestly.
REWARDS_CONTRACT=
